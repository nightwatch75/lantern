# Copy to .env and edit: cp .env.example .env

# Login. Both set = the user is created (or its password updated) at every start,
# and .env wins over a change made in the web page. Empty = no user is created.
# An existing user in the volume is never removed by emptying these: use --disable-login.
# The password needs at least 8 characters (200 at most), or the container stops at start.
LANTERN_USER=
LANTERN_PASSWORD=

# Listen address and port. 0.0.0.0 (all interfaces) needs a login user above.
# With 127.0.0.1 the page is reachable only from this machine.
LANTERN_HOST=127.0.0.1
LANTERN_PORT=8099

# Where the database lives: a Docker volume name, or a host folder (/srv/lantern, ./data)
LANTERN_DATA=lantern-data

# Optional: subnets to sweep when the detection picks the wrong network (space or comma separated, /22 at most)
#LANTERN_SUBNET=192.168.1.0/24
# Optional: 1 = no discovery on first start
#LANTERN_NO_DISCOVER=1

TZ=Europe/Rome

# Identify (the globe button) searches the web for model codes. 1 = never, and hide the button.
LANTERN_NO_WEB=
# Search page used by Identify, {q} is the query. HTML (DuckDuckGo, default) or JSON (your own SearXNG).
LANTERN_SEARCH_URL=
